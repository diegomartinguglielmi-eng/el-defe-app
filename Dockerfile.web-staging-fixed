FROM python:3.12-alpine
WORKDIR /site
COPY ui-operativa-base/ /site/
COPY web-defe-core.js web-family-onboarding.js web-family-laamba-level.js web-attendance-player-v2.js web-home-family.js web-role-experience.js /site/
RUN mkdir -p /site/el-defe-app && cp -a /site/assets /site/el-defe-app/assets && cp /site/icon.png /site/el-defe-app/icon.png && cp /site/manifest.webmanifest /site/el-defe-app/manifest.webmanifest && cp /site/escudo-dsl.svg /site/el-defe-app/escudo-dsl.svg && python3 -c "from pathlib import Path; prod='https://el-defe-v5-production.up.railway.app'; stage='https://el-defe-v2-staging-production.up.railway.app'; files=[Path('/site/index.html'),Path('/site/web-auth-overlay-netlify.js')]+list(Path('/site/assets').glob('*.js'))+list(Path('/site/el-defe-app/assets').glob('*.js')); [(p.write_text(p.read_text().replace(prod,stage))) for p in files if prod in p.read_text()]; p=Path('/site/index.html'); s=p.read_text(); names=['web-defe-core.js','web-family-onboarding.js','web-family-laamba-level.js','web-attendance-player-v2.js','web-home-family.js','web-role-experience.js']; tags=''.join('<script src=\"./'+n+'\"></script>' for n in names if n not in s); p.write_text(s.replace('</body>',tags+'</body>'))"
EXPOSE 8080
CMD ["python3","-m","http.server","8080","--directory","/site"]
